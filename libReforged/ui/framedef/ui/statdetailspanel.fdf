String "SimpleInfoPanelTextTemplate" {
    FontJustificationH JUSTIFYLEFT,
    FontJustificationV JUSTIFYTOP,
    FontColor 0.99 0.827 0.0705 1.0,
	FontShadowColor 0.0 0.0 0.0 0.9,
    FontShadowOffset 0.001 -0.001,
	Font "InfoPanelTextFont",0.006,
}

Frame "SIMPLEFRAME" "SimpleStatDetailsPanel" {
    UseActiveContext,
	DecorateFileNames,
	Width 0.14,
	Height 0.1204,
}

Frame "SIMPLEFRAME" "SimpleStatDetailsItem" {
    UseActiveContext,
    DecorateFileNames,
    Height 0.007525,
	Width 0.14,  

    String "SimpleStatDetailsItemLabel" INHERITS "SimpleInfoPanelTextTemplate" {
        SetPoint LEFT, "SimpleStatDetailsItem", LEFT, 0.012, 0.0,
        Text "",
        Height 0.007525,
        Width 0.1,
    }

    String "SimpleStatDetailsItemValue" INHERITS "SimpleInfoPanelTextTemplate" {
        SetPoint RIGHT, "SimpleStatDetailsItem", RIGHT, 0.0, 0.0,
        Text "",
        Height 0.007525,
        Width 0.025,
    }
}

